#include "../../includes/includes.h"

static void	init_redirs(t_shell *shell, int nb_pipes)
{
        int                     i;

        redir = shell->exec.redirs;
        i = 0;
        while (i < nb_pipes + 1)
        {
                redir[i].fname_in = NULL;
                redir[i].fname_out = NULL;
                redir[i].delimiter = NULL;
                redir[i].fd_in = -1;
                redir[i].fd_out = -1;
                i++;
        }
}

static t_token	*redir_out_ww(t_redirs redir, t_token *list)
{
	if (redir.fd_out != -1)
		close(redir.fd_out);
	if (list->token_type == REDIR_OUT_WW)
		redir.fname_out = ft_strdup(list->content + 1);
	else
		redir.fname_out = ft_strdup(list->content + 2);
	if (!redir.fname_out)
		return (goto_next_command(list, 1));
	if (list->token_type == REDIR_OUT_WW)
	{
		redir.fd_out = open(redir.fname_out,
			O_WRONLY | O_CREAT | O_TRUNC, 0644);
	}
	else
	{
		redir.fd_out = open(redir.fname_out,
			O_WRONLY | O_CREAT | O_APPEND, 0644);
	}
	if (redir.fd_out < 0)
		return (goto_next_command(list, 0));
	return (list);
}

static t_token	*redir_out(t_redirs redir, t_token *list)
{
	if (redir.fd_out != -1)
		close(redir.fd_out);
	redir.fname_out = ft_strdup(list->next->content);
	if (!redir[i].fname_out)
		return (goto_next_command(list, 1));
	if (list->token_type == REDIR_OUT)
		redir.fd_out = open(redir.fname_out,
			O_WRONLY | O_CREAT | O_TRUNC, 0644);
	else
		redir.fd_out = open(redir.fname_out,
			O_WRONLY | O_CREAT | O_APPEND, 0644);
	if (redir.fd_out < 0)
		return (goto_next_command(list, 0));
	return (list);
}

static t_token	*redir_in(t_redirs redir, t_token *list)
{

	if (redir[i].fd_in != -1)
		close(redir[i].fd_in);
	if (list->token_type == REDIR_IN_WW)
			redir[i].fname_in = ft_strdup(list->content + 1);
	else
		redir[i].fname_in = ft_strdup(list->next->content);
	if (!redir[i].fname_in)
		return (goto_next_command(list, 1));
	redir[i].fd_in = open(redir[i].fname_in, O_RDONLY);
	if (redir[i].fd_in < 0)
			return (goto_next_command(list, 0));
	return (list);
}

int      get_redirs(t_shell *shell, int nb_pipes)
{
        int                     i;
        t_token         *list;
        t_redirs        *redir;

		init_redirs(shell, nb_pipes);
        redir = shell->exec.redirs;
        list = shell->tokens;
        i = 0;
        while (list)
        {
                if (list->token_type == PIPE)
                        i++;
                else if (list->token_type == REDIR_OUT_WW
                        || list->token_type == REDIR_OUT_APP_MODE_WW)
                	list = redir_out_ww(redir, list);
				else if (list->token_type == REDIR_OUT
                        || list->token_type == REDIR_OUT_APP_MODE)
                	list = redir_out(redir, list);
                else if (list->token_type == REDIR_IN_WW || list->token_type == REDIR_IN)
                	list = redir_in(redir, list);
                else if (list->token_type == HEREDOC_WW || list->token_type == HEREDOC)
					list = heredoc(redir[i], shell, list)
                list = list->next;
        }
        return (0);
}

